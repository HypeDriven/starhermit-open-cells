{
  "name": "open-cells",
  "version": "1.0.0",
  "description": "Open-information card puzzle on a brass-and-slate strategy desk, on the StarHermit engine.",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.js tests/session.test.js tests/store.test.js tests/i18n.test.js",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "textures": "node tools/bake-textures.mjs",
    "validate": "node tools/validate.js",
    "validate:rescue": "node tools/validate.js --rescue"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
